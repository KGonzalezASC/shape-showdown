# Optional overrides (config files are the main source of truth):
# PORT=3000
# SERVE_CLIENT=true
# REPLAYS_DIR=fixtures/replays
#
# Socket.IO target (static page on 443, game server on another port on same host):
# Either set in public/game-config.json (copied to dist) after deploy, or at build time:
# VITE_GAME_SERVER_URL=https://skillcade.example.com:10106
# VITE_GAME_SERVER_PORT=10106
# VITE_GAME_SERVER_HOST=skillcade.example.com
#
# Optional if config/client.json is missing / base is "/":
# Optional override for Vite asset base (normally set in config/client.json).
# Use ./ for subdirectory/embed deploys (assets relative to index.html).
# VITE_BASE_URL=./

# Local split-mode dev example (Vite client on 5173, server on 3000):
# VITE_GAME_SERVER_URL=http://localhost:3000
#
# Internal staging / QA builds only — exposes lock-debug panel, shop mock (V), etc.
# Omit or leave unset for public production builds.
# VITE_DEV_TOOLS=true

# Discord Activity (Developer Portal → General Information / OAuth2)
# Copy Application ID + Public Key into a local .env (gitignored). Never commit secrets.
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# VITE_DISCORD_CLIENT_ID=   # usually same as Application ID
# DISCORD_CLIENT_SECRET=    # OAuth2 → Client Secret only; never commit

# Local Cloudflare quick-tunnel hostname allowed by Vite's Host-header check.
# Update this when cloudflared creates a new hostname.
# DEV_ALLOWED_HOSTS=your-tunnel.trycloudflare.com

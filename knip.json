{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/landing.tsx",
    "src/replay.tsx",
    "src/nameDrop/nameDrop.worker.ts",
    "src/nameDrop/nameDropRender.worker.ts",
    "scripts/**/*.{ts,mts,mjs,cjs}",
    "server/**/*.test.ts",
    "src/**/*.test.ts"
  ],
  "project": [
    "server/**/*.ts",
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mts,mjs,cjs}"
  ],
  "vite": {
    "config": ["vite.config.mjs", "vite.replay.config.mjs"]
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "ignoreIssues": {
    "src/types.ts": ["exports"],
    "server/loadConfig.ts": ["types"],
    "server/puzzleEngine/engine.ts": ["exports"]
  },
  "ignoreDependencies": ["tailwindcss"]
}

{
  "name": "shape-showdown",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun server.ts",
    "dev:server": "cross-env NODE_ENV=production bun server.ts",
    "dev:client": "bunx vite",
    "dev:local": "cross-env VITE_GAME_SERVER_URL=http://localhost:3000 bunx vite",
    "build:client": "bunx vite build",
    "build:replay": "bunx vite build -c vite.replay.config.mjs",
    "build:server": "bun build server.ts --target=node --outfile=dist-server/server.mjs",
    "build:server:bin": "bun build server.ts --compile --target=bun-linux-x64 --define 'process.env.NODE_ENV=\"production\"' --outfile=dist-server/shape-showdown-server.x86_64",
    "build": "bun run build:client && bun run build:server",
    "build:internal": "bun run build:client && bun run build:replay && bun run build:server",
    "preview": "bunx vite preview",
    "clean": "rimraf dist dist-server .dev-server.mjs",
    "lint": "tsc --noEmit",
    "test": "bun test server/**/*.test.ts server/tetris/**/*.test.ts",
    "test:all": "bun run test",
    "test:board": "bun test server/boardVisualModel.test.ts",
    "test:engine": "bun test server/tetris/engine.test.ts",
    "test:poison": "bun test server/tetris/poison_variations.test.ts",
    "test:shop": "bun test server/shop.test.ts",
    "test:manager": "bun test server/GameManager.test.ts",
    "test:name-drop": "bun test server/nameDrop.test.ts",
    "test:harness": "bun test server/testHarness/**/*.test.ts",
    "test:pricing": "bun scripts/pricing-lab.mts",
    "test:smoke": "bun scripts/live-smoke.mts",
    "test:baseline": "bun scripts/generate-baseline-evidence.mts",
    "knip": "knip",
    "lint:dead-code": "knip",
    "doctor": "react-doctor --yes --offline --fail-on warning",
    "start": "cross-env NODE_ENV=production bun dist-server/server.mjs",
    "start:serve-client": "cross-env NODE_ENV=production SERVE_CLIENT=true bun dist-server/server.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "knip": "^6.16.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "puppeteer": "^25.5.0",
    "react": "^19.0.0",
    "react-doctor": "^0.0.39",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
